<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_adventure_ai_usage_tree" model="ir.ui.view">
        <field name="name">adventure.ai.usage.list</field>
        <field name="model">adventure.ai.usage</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="feature"/>
                <field name="capability_name"/>
                <field name="provider"/>
                <field name="model"/>
                <field name="input_tokens"/>
                <field name="output_tokens"/>
                <field name="estimated_cost"/>
                <field name="latency_ms"/>
                <field name="success"/>
            </list>
        </field>
    </record>

    <record id="action_adventure_ai_usage" model="ir.actions.act_window">
        <field name="name">AI Usage</field>
        <field name="res_model">adventure.ai.usage</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_adventure_ai_usage"
              name="Usage"
              parent="menu_adventure_ai_root"
              action="action_adventure_ai_usage"
              sequence="20"/>
</odoo>
