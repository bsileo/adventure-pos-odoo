<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_adventure_ai_session_tree" model="ir.ui.view">
        <field name="name">adventure.ai.session.list</field>
        <field name="model">adventure.ai.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="profile"/>
                <field name="channel"/>
                <field name="state"/>
                <field name="turn_count"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="view_adventure_ai_session_form" model="ir.ui.view">
        <field name="name">adventure.ai.session.form</field>
        <field name="model">adventure.ai.session</field>
        <field name="arch" type="xml">
            <form string="AI Session">
                <header>
                    <button name="action_close" type="object" string="Close" invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="profile"/>
                            <field name="channel"/>
                        </group>
                        <group>
                            <field name="turn_count"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Turns">
                            <field name="turn_ids">
                                <list>
                                    <field name="sequence"/>
                                    <field name="role"/>
                                    <field name="tool_name"/>
                                    <field name="content"/>
                                </list>
                            </field>
                        </page>
                        <page string="Usage">
                            <field name="usage_ids">
                                <list>
                                    <field name="create_date"/>
                                    <field name="feature"/>
                                    <field name="capability_name"/>
                                    <field name="provider"/>
                                    <field name="model"/>
                                    <field name="input_tokens"/>
                                    <field name="output_tokens"/>
                                    <field name="estimated_cost"/>
                                    <field name="success"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_adventure_ai_session" model="ir.actions.act_window">
        <field name="name">AI Sessions</field>
        <field name="res_model">adventure.ai.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_adventure_ai_root"
              name="Adventure AI"
              groups="adventure_ai.group_manager"
              sequence="90"/>
    <menuitem id="menu_adventure_ai_session"
              name="Sessions"
              parent="menu_adventure_ai_root"
              action="action_adventure_ai_session"
              sequence="10"/>
</odoo>
