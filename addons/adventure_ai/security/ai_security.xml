<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_adventure_ai" model="ir.module.category">
        <field name="name">Adventure AI</field>
        <field name="sequence">56</field>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_adventure_ai"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Invoke AdventurePOS AI capabilities (POS and backend).</field>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_adventure_ai"/>
        <field name="implied_ids" eval="[(4, ref('adventure_ai.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configure Adventure AI providers and review usage.</field>
    </record>
</odoo>
