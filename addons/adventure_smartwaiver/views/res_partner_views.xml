<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_smartwaiver" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.smartwaiver</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_smartwaiver_waivers"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        groups="adventure_smartwaiver.group_smartwaiver_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="smartwaiver_waiver_count"/>
                        </span>
                        <span class="o_stat_text">Waivers</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Smartwaiver" groups="adventure_smartwaiver.group_smartwaiver_user">
                    <field name="smartwaiver_status"/>
                    <button name="action_search_smartwaiver"
                            type="object"
                            string="Search Smartwaiver"
                            class="btn-link"
                            groups="adventure_smartwaiver.group_smartwaiver_manager"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
