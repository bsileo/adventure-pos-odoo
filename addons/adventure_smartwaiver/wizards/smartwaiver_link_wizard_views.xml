<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smartwaiver_link_wizard_form" model="ir.ui.view">
        <field name="name">smartwaiver.link.wizard.form</field>
        <field name="model">smartwaiver.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Link waiver">
                <group>
                    <field name="waiver_id" readonly="1"/>
                    <field name="partner_id"/>
                </group>
                <footer>
                    <button name="action_link" type="object" string="Link" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
