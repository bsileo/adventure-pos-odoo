<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_adventure_smartwaiver" model="ir.module.category">
        <field name="name">Smartwaiver</field>
        <field name="description">Access to Smartwaiver waiver records</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_smartwaiver_user" model="res.groups">
        <field name="name">Smartwaiver User</field>
        <field name="category_id" ref="module_category_adventure_smartwaiver"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_smartwaiver_manager" model="res.groups">
        <field name="name">Smartwaiver Manager</field>
        <field name="category_id" ref="module_category_adventure_smartwaiver"/>
        <field name="implied_ids" eval="[(4, ref('group_smartwaiver_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
