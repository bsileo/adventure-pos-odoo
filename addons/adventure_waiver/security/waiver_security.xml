<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_adventure_waiver" model="ir.module.category">
        <field name="name">Waivers</field>
        <field name="description">Access to signed waiver records</field>
        <field name="sequence">40</field>
    </record>

    <record id="res_groups_privilege_waiver" model="res.groups.privilege">
        <field name="name">Waivers</field>
        <field name="category_id" ref="module_category_adventure_waiver"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_waiver_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_waiver"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_waiver_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_waiver"/>
        <field name="implied_ids" eval="[(4, ref('group_waiver_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
