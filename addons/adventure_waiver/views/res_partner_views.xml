<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_adventure_waiver" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.adventure.waiver</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_adventure_waivers"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        groups="adventure_waiver.group_waiver_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="adventure_waiver_count"/>
                        </span>
                        <span class="o_stat_text">Waivers</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Waivers" groups="adventure_waiver.group_waiver_user">
                    <field name="adventure_waiver_status"/>
                    <button name="action_search_provider_waivers"
                            type="object"
                            string="Search providers"
                            class="btn-link"
                            groups="adventure_waiver.group_waiver_manager"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
