<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_override_wizard_form" model="ir.ui.view">
        <field name="name">adventure.equipment.service.override.wizard.form</field>
        <field name="model">adventure.equipment.service.override.wizard</field>
        <field name="arch" type="xml">
            <form string="Override Schedule">
                <group>
                    <field name="requirement_id" readonly="1"/>
                    <field name="next_due_date"/>
                    <field name="warning_date"/>
                    <field name="interval_quantity"/>
                    <field name="interval_unit"/>
                    <field name="is_recurring"/>
                    <field name="expiration_date"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply Override" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
