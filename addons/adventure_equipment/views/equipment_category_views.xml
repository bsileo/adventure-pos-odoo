<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_adventure_equipment_category_list" model="ir.ui.view">
        <field name="name">adventure.equipment.category.list</field>
        <field name="model">adventure.equipment.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="is_serviceable"/>
                <field name="is_durable"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_adventure_equipment_category_form" model="ir.ui.view">
        <field name="name">adventure.equipment.category.form</field>
        <field name="model">adventure.equipment.category</field>
        <field name="arch" type="xml">
            <form string="Equipment Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Category name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="is_serviceable"/>
                            <field name="is_durable"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Children" name="children">
                            <field name="child_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="is_serviceable"/>
                                    <field name="is_durable"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_adventure_equipment_category_search" model="ir.ui.view">
        <field name="name">adventure.equipment.category.search</field>
        <field name="model">adventure.equipment.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="filter_serviceable" string="Serviceable" domain="[('is_serviceable', '=', True)]"/>
                <filter name="filter_durable" string="Durable" domain="[('is_durable', '=', True)]"/>
                <separator/>
                <filter name="group_parent" string="Parent" context="{'group_by': 'parent_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_adventure_equipment_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">adventure.equipment.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_adventure_equipment_category_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create equipment categories
            </p>
            <p>
                Categories classify customer-owned equipment independently of product catalog categories.
            </p>
        </field>
    </record>
</odoo>
