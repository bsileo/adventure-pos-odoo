<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_adventure_equipment_tag_list" model="ir.ui.view">
        <field name="name">adventure.equipment.tag.list</field>
        <field name="model">adventure.equipment.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_adventure_equipment_tag_form" model="ir.ui.view">
        <field name="name">adventure.equipment.tag.form</field>
        <field name="model">adventure.equipment.tag</field>
        <field name="arch" type="xml">
            <form string="Equipment Tag">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_adventure_equipment_tag_search" model="ir.ui.view">
        <field name="name">adventure.equipment.tag.search</field>
        <field name="model">adventure.equipment.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_adventure_equipment_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">adventure.equipment.tag</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_adventure_equipment_tag_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create equipment tags
            </p>
            <p>
                Tags provide flexible labels for filtering and grouping equipment records.
            </p>
        </field>
    </record>
</odoo>
