<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_adventure_equipment_event_list" model="ir.ui.view">
        <field name="name">adventure.equipment.event.list</field>
        <field name="model">adventure.equipment.event</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="event_date"/>
                <field name="event_type"/>
                <field name="summary"/>
                <field name="user_id"/>
                <field name="asset_id" column_invisible="context.get('default_asset_id')"/>
                <field name="company_id" groups="base.group_multi_company" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_adventure_equipment_event_search" model="ir.ui.view">
        <field name="name">adventure.equipment.event.search</field>
        <field name="model">adventure.equipment.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="summary"/>
                <field name="asset_id"/>
                <field name="event_type"/>
                <field name="user_id"/>
                <separator/>
                <filter name="group_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                <filter name="group_asset" string="Equipment" context="{'group_by': 'asset_id'}"/>
                <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_adventure_equipment_event" model="ir.actions.act_window">
        <field name="name">Equipment Events</field>
        <field name="res_model">adventure.equipment.event</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_adventure_equipment_event_search"/>
    </record>
</odoo>
