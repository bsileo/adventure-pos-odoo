<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_adventure_equipment_ownership_transfer_wizard_form" model="ir.ui.view">
        <field name="name">adventure.equipment.ownership.transfer.wizard.form</field>
        <field name="model">adventure.equipment.ownership.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Ownership">
                <group>
                    <group>
                        <field name="asset_id" readonly="1"/>
                        <field name="from_partner_id" readonly="1"/>
                        <field name="to_partner_id"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="transfer_date"/>
                        <field name="reason"/>
                        <field name="verification_state"/>
                    </group>
                </group>
                <group string="Notes">
                    <field name="notes" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm Transfer"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
