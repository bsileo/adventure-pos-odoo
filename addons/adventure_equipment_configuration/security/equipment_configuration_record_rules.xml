<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="equipment_configuration_company_rule" model="ir.rule">
        <field name="name">Equipment configuration: multi-company</field>
        <field name="model_id" ref="model_adventure_equipment_configuration"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="equipment_configuration_line_company_rule" model="ir.rule">
        <field name="name">Equipment configuration line: multi-company</field>
        <field name="model_id" ref="model_adventure_equipment_configuration_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
