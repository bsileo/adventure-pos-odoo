<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="demo_partner_scuba_diver" model="res.partner">
        <field name="name">Demo Scuba Diver</field>
        <field name="email">scuba.diver@example.com</field>
    </record>

    <record id="demo_asset_al80_cylinder" model="adventure.equipment.asset">
        <field name="nickname">Travel AL80</field>
        <field name="partner_id" ref="demo_partner_scuba_diver"/>
        <field name="category_id" ref="adventure_equipment.equipment_category_cylinder"/>
        <field name="brand_name">Luxfer</field>
        <field name="model_name">S80</field>
        <field name="serial_number">DEMO-CYL-AL80-001</field>
        <field name="lifecycle_state">active</field>
        <field name="in_service_date">2024-06-01</field>
        <field name="scuba_cylinder_material">aluminum</field>
        <field name="scuba_water_capacity_l">11.1</field>
        <field name="scuba_working_pressure_bar">207</field>
        <field name="scuba_working_pressure_psi">3000</field>
        <field name="scuba_gas_compatibility">nitrox</field>
        <field name="scuba_oxygen_clean" eval="True"/>
        <field name="scuba_valve_type">DIN/Yoke</field>
    </record>

    <record id="demo_asset_regulator_set" model="adventure.equipment.asset">
        <field name="nickname">Primary Reg</field>
        <field name="partner_id" ref="demo_partner_scuba_diver"/>
        <field name="category_id" ref="adventure_equipment.equipment_category_regulator"/>
        <field name="brand_name">Scubapro</field>
        <field name="model_name">MK25 EVO / S620</field>
        <field name="serial_number">DEMO-REG-001</field>
        <field name="lifecycle_state">active</field>
        <field name="in_service_date">2024-06-01</field>
        <field name="scuba_regulator_configuration">complete_set</field>
    </record>

    <record id="demo_asset_bcd" model="adventure.equipment.asset">
        <field name="nickname">Travel BCD</field>
        <field name="partner_id" ref="demo_partner_scuba_diver"/>
        <field name="category_id" ref="adventure_equipment.equipment_category_bcd"/>
        <field name="brand_name">Apeks</field>
        <field name="model_name">WTXcx</field>
        <field name="serial_number">DEMO-BCD-001</field>
        <field name="lifecycle_state">active</field>
        <field name="in_service_date">2024-06-01</field>
        <field name="scuba_bcd_type">wing</field>
    </record>
</odoo>
