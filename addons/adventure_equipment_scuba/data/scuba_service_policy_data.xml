    <!-- Drysuit leak test annual (exposure suit category; shops can narrow later) -->
    <record id="policy_drysuit_leak_annual" model="adventure.equipment.service.policy">
        <field name="name">Drysuit Leak Test — Annual</field>
        <field name="code">SCUBA_POL_DRYSUIT</field>
        <field name="service_type_id" ref="service_type_drysuit_leak_test"/>
