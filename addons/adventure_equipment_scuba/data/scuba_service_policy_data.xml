    <!-- Dive computer manufacturer service (24 months default) -->
    <record id="policy_dive_computer_service_24m" model="adventure.equipment.service.policy">
        <field name="name">Dive Computer Service — 24 Months</field>
        <field name="code">SCUBA_POL_DC</field>
        <field name="service_type_id" ref="service_type_dive_computer_service"/>
