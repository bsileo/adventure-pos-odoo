        <field name="service_type_id" ref="service_type_regulator_service"/>
        <field name="policy_source">manufacturer</field>
        <field name="category_id" ref="adventure_equipment.equipment_category_regulator"/>
        <field name="priority">50</field>
        <field name="is_recurring" eval="True"/>
        <field name="interval_quantity">12</field>
        <field name="interval_unit">months</field>
        <field name="warning_lead_days">45</field>
        <field name="grace_days">14</field>
        <field name="first_due_basis">in_service_date</field>
