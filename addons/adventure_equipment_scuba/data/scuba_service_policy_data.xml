        <field name="name">BCD Service — Annual</field>
        <field name="code">SCUBA_POL_BCD</field>
        <field name="service_type_id" ref="service_type_bcd_service"/>
        <field name="policy_source">manufacturer</field>
        <field name="category_id" ref="adventure_equipment.equipment_category_bcd"/>
        <field name="priority">50</field>
        <field name="is_recurring" eval="True"/>
        <field name="interval_quantity">12</field>
