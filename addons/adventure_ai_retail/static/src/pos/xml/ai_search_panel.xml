<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="adventure_ai_retail.AiSearchPanel">
        <Dialog title.translate="AI product search" size="'md'" contentClass="'adventure-ai-search-dialog'">
            <div class="adventure-ai-search-panel p-2">
                <form class="d-flex gap-2 mb-3" t-on-submit="onSubmit">
                    <input type="text"
                           class="form-control form-control-lg"
                           placeholder="e.g. men's 7mm semi-dry size L"
                           t-model="state.query"
                           t-att-disabled="state.loading"/>
                    <button type="submit"
                            class="btn btn-primary btn-lg"
                            t-att-disabled="state.loading || !state.query.trim()">
                        <t t-if="state.loading">…</t>
                        <t t-else="">Search</t>
                    </button>
                </form>

                <div t-if="state.error" class="alert alert-danger" t-esc="state.error"/>
                <div t-if="state.assistantText" class="text-muted mb-2" t-esc="state.assistantText"/>

                <div class="list-group adventure-ai-product-results">
                    <button type="button"
                            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                            t-foreach="state.products"
                            t-as="product"
                            t-key="product.product_id"
                            t-on-click="() => this.onSelectProduct(product)">
                        <span>
                            <strong t-esc="product.name"/>
                            <span t-if="product.default_code" class="text-muted ms-2" t-esc="product.default_code"/>
                        </span>
                        <span class="badge text-bg-light" t-esc="product.list_price"/>
                    </button>
                </div>
                <div t-if="!state.loading and state.query and !state.products.length and !state.error"
                     class="text-muted mt-2">
                    No matching POS products.
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="onClose">Close</button>
            </t>
        </Dialog>
    </t>
</templates>
