# Copy to `.env` and fill in. Never commit `.env`.
# Use Unix (LF) line endings for `.env` if you use WSL or bash scripts; CRLF can break docker/env.
# Cursor cloud: optional secrets OPENAI_API_KEY / SMARTWAIVER_API_KEY / POSTGRES_PASSWORD
# are merged by scripts/ensure-dotenv.sh when present in the environment.
# Cloud agents also set COMPOSE_FILE=docker-compose.cloud.yml (host networking) and
# ODOO_DB_HOST=127.0.0.1 because Docker bridge networking often fails on nested VMs.
# OpenAI: https://platform.openai.com/api-keys (optional for core Tidewater bootstrap)
OPENAI_API_KEY=

# Optional: Smartwaiver API key for adventure_smartwaiver (prefer Settings UI when installed).
# Not required for Tidewater bootstrap today.
# SMARTWAIVER_API_KEY=

ODOO_VERSION=19.0
POSTGRES_DB=odoo
POSTGRES_USER=odoo
# Local dev only; use a strong value outside your machine.
POSTGRES_PASSWORD=change_me_local_dev
# Postgres binds to localhost by default, which is safer for remote VMs.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432
# Optional: Docker named volume for Postgres files (default: adventurepos-sandbox-postgres).
# Shared GCP sandbox: leave unset so data keeps the same volume across VM reboots and deploys.
# Local: set a unique name per clone if you run several copies on one Docker host.
# Cursor cloud (set automatically by ensure-dotenv): adventurepos-cloud-postgres
# POSTGRES_VOLUME_NAME=adventurepos-local-pg
# Cursor cloud only (set automatically): COMPOSE_FILE=docker-compose.cloud.yml
# COMPOSE_FILE=docker-compose.yml
# DB host seen by odoo CLI inside the container (db on bridge; 127.0.0.1 on cloud host net)
# ODOO_DB_HOST=db
ODOO_PORT=8069
